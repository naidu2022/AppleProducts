{
	"name": "AppleProdcuts",
	"version": "1.0.0",
	"dependencies": {
		"@cap-js/hana": "^2",
		"@sap/cds": "^9",
		"@sap/xssec": "^4"
	},
	"devDependencies": {
		"@cap-js/sqlite": "^2.4",
		"cds-plugin-ui5": "^0.17.0",
		"@sap/dev-cap-tools": "^1.31.0"
	},
	"scripts": {
		"start": "cds-serve",
		"watch-project1": "cds watch --open project1/index.html?sap-ui-xx-viewCache=false --livereload false"
	},
	"private": true,
	"cds": {
		"requires": {
			"db": {
			"kind": "hana"
			},
			"[production]": {
				"auth": "xsuaa"
			}
		}
	},
	"workspaces": [
		"app/*"
	],
	"sapux": [
		"app/project1"
	]
}